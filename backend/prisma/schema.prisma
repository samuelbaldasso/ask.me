// Prisma schema — Ask.me backend
// Banco: PostgreSQL + PostGIS + pgvector
//
// Nota: coordenadas geográficas (lat/lng) são armazenadas como campos Float
// por simplicidade de leitura via Prisma. As queries de proximidade usam
// SQL raw com ST_DWithin / ST_Distance (PostGIS). A coluna `location`
// é um GEOGRAPHY(POINT,4326) gerenciada via migração SQL customizada.
//
// pgvector (campo `embedding`) será populado na Fase 3 (RAG). Fica no schema
// agora para evitar migração disruptiva depois, mas não é usado na Fase 1.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, pgvector(map: "vector")]
}

// Usuário autenticado via Google Sign-In (OAuth). Login é opcional no MVP —
// só é exigido no fluxo de assinatura (ver Subscription).
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  avatarUrl     String?  @map("avatar_url")
  googleId      String   @unique @map("google_id")

  subscription  Subscription?
  favorites     Favorite[]

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt      @map("updated_at")

  @@map("users")
}

enum SubscriptionStatus {
  incomplete
  active
  past_due
  canceled
  unpaid
}

// Assinatura mensal via Stripe (R$20,00/mês). MVP cobre apenas cartão de
// crédito (Stripe Subscriptions nativo, renovação automática). Pix fica
// registrado como dívida técnica: Stripe não suporta débito automático
// recorrente via Pix — exigiria gerar uma cobrança nova por ciclo
// (collection_method: send_invoice), fluxo com fricção manual mensal.
model Subscription {
  id                    String             @id @default(cuid())
  userId                String             @unique @map("user_id")
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  stripeCustomerId      String             @unique @map("stripe_customer_id")
  stripeSubscriptionId  String?            @unique @map("stripe_subscription_id")
  stripePriceId         String?            @map("stripe_price_id")

  status                SubscriptionStatus @default(incomplete)
  currentPeriodEnd      DateTime?          @map("current_period_end")
  cancelAtPeriodEnd     Boolean            @default(false) @map("cancel_at_period_end")

  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt      @map("updated_at")

  @@map("subscriptions")
}

model Category {
  id     Int     @id @default(autoincrement())
  slug   String  @unique // ex: "restaurante", "farmacia", "pet-shop"
  label  String  // ex: "Restaurante", "Farmácia"
  places Place[]

  @@map("categories")
}

model Place {
  id            String   @id @default(cuid())
  name          String
  description   String?
  phone         String?
  website       String?
  address       String
  city          String
  state         String   @default("SP")
  zipCode       String?  @map("zip_code")
  // Preenchido quando o place é descoberto via Google Places Nearby Search
  // (src/db/discoverPlaces.ts) — usado para upsert idempotente entre execuções.
  // null para places cadastrados manualmente (seeds).
  googlePlaceId String?  @unique @map("google_place_id")

  // Coordenadas armazenadas explicitamente para leitura simples via Prisma ORM
  lat         Float
  lng         Float
  // Coluna PostGIS criada via SQL na migração (ver abaixo)
  // location    GEOGRAPHY(POINT,4326)  — gerenciada fora do Prisma

  categoryId  Int      @map("category_id")
  category    Category @relation(fields: [categoryId], references: [id])

  hours       OpeningHours[]
  attributes  PlaceAttribute[]
  favoritedBy Favorite[]

  acceptsPets   Boolean @default(false) @map("accepts_pets")
  acceptsCards  Boolean @default(true)  @map("accepts_cards")
  hasParking    Boolean @default(false) @map("has_parking")
  isActive      Boolean @default(true)  @map("is_active")

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt      @map("updated_at")

  @@index([categoryId])
  @@index([isActive])
  @@map("places")
}

// Horários de funcionamento por dia da semana
// dayOfWeek: 0 = domingo, 6 = sábado (padrão JS Date.getDay())
model OpeningHours {
  id        Int    @id @default(autoincrement())
  placeId   String @map("place_id")
  place     Place  @relation(fields: [placeId], references: [id], onDelete: Cascade)
  dayOfWeek Int    @map("day_of_week") // 0-6
  opensAt   String @map("opens_at")   // "HH:MM"
  closesAt  String @map("closes_at")  // "HH:MM"
  isClosed  Boolean @default(false)   @map("is_closed")

  @@unique([placeId, dayOfWeek])
  @@map("opening_hours")
}

// Lugares salvos/favoritados por um usuário — feature de retenção do MVP.
// Requer login (ao contrário da busca, que é livre), pois é sempre
// associado a um usuário.
model Favorite {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  placeId   String   @map("place_id")
  place     Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, placeId])
  @@map("favorites")
}

// Atributos livres para extensibilidade futura (ex: "wifi", "drive-thru")
model PlaceAttribute {
  id      Int    @id @default(autoincrement())
  placeId String @map("place_id")
  place   Place  @relation(fields: [placeId], references: [id], onDelete: Cascade)
  key     String
  value   String

  @@unique([placeId, key])
  @@map("place_attributes")
}
