# App
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://askme:askme_pass@localhost:5432/askme_db

# JWT
JWT_SECRET=change_me_before_production
JWT_EXPIRES_IN=7d

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Maps API (Fase 1 — opcional)
GOOGLE_PLACES_API_KEY=

# LLM (Fase 3 — opcional; sem a chave, /ask cai para busca tradicional)
ANTHROPIC_API_KEY=

# Auth social — Google Sign-In
# GOOGLE_CLIENT_ID: Web Client ID (usado como serverClientId no app e como audience padrão)
# GOOGLE_IOS_CLIENT_ID: Client ID do tipo iOS (audience do idToken emitido no app iOS)
GOOGLE_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

# Stripe — assinatura mensal (cartão de crédito)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MONTHLY=
# URLs de retorno do Checkout/Billing Portal. Default aponta para o domínio
# de produção; sobrescreva aqui se o domínio mudar.
STRIPE_CHECKOUT_SUCCESS_URL=https://www.ask-me.company/subscription
STRIPE_CHECKOUT_CANCEL_URL=https://www.ask-me.company/subscription
STRIPE_BILLING_PORTAL_RETURN_URL=https://www.ask-me.company/subscription

# Origem permitida no CORS da API. Em produção, o domínio do site web.
ALLOWED_ORIGIN=http://localhost:3000
